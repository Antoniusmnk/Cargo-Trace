{
	"info": {
		"_postman_id": "cargotrace-auth-milestone-p8",
		"name": "CargoTrace - Authentication API (Milestone P8)",
		"description": "REST API Authentication Endpoints using Laravel Sanctum for CargoTrace Platform (Global Shipment Visibility & Tracking).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Authentication",
			"description": "Public and protected authentication endpoints for customer self-registration, role login, profile fetching, and token revocation.",
			"item": [
				{
					"name": "Register Customer (Self-Service)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    if (json.data && json.data.token) {",
									"        pm.environment.set(\"auth_token\", json.data.token);",
									"        console.log(\"Saved new auth_token from registration:\", json.data.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"PT Samudera Pratama\",\n    \"email\": \"samudera@example.test\",\n    \"password\": \"password\",\n    \"password_confirmation\": \"password\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"register"
							]
						},
						"description": "Registers a new customer account and automatically returns a personal access Bearer token."
					},
					"response": []
				},
