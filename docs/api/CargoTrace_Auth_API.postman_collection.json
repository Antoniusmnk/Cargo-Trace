				{
					"name": "Get Authenticated User Profile",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Profile data returned correctly\", function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.success).to.be.true;",
									"    pm.expect(json.data).to.have.property('id');",
									"    pm.expect(json.data).to.have.property('name');",
									"    pm.expect(json.data).to.have.property('email');",
									"    pm.expect(json.data).to.have.property('role');",
									"    pm.expect(json.data).to.have.property('status');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/user",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"user"
							]
						},
						"description": "Fetches current authenticated user attributes including role and status."
					},
					"response": []
				},
				{
					"name": "Logout (Revoke Current Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Token revoked successfully\", function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.success).to.be.true;",
									"    pm.environment.set(\"auth_token\", \"\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"logout"
							]
						},
						"description": "Revokes the active personal access Bearer token from the database and clears `auth_token` in the environment."
					},
					"response": []
				}
			]
		}
