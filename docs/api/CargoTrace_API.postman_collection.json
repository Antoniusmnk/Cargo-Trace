				{
					"name": "2. Report New Exception with Impact Hours (Operator)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () { pm.response.to.have.status(201); });",
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    if (json.data && json.data.exception && json.data.exception.id) {",
									"        pm.environment.set(\"exception_id\", json.data.exception.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Content-Type", "value": "application/json", "type": "text"},
