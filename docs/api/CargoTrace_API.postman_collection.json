{
	"info": {
		"_postman_id": "cargotrace-api-v2-full",
		"name": "CargoTrace - Platform API (Milestones P8 & P9)",
		"description": "Full REST API Collection for CargoTrace Platform: Authentication (Sanctum), Master Data (Carriers & Locations), and Shipment Management CRUD.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Authentication",
			"description": "Public and protected authentication endpoints using Laravel Sanctum.",
			"item": [
				{
					"name": "Register Customer (Self-Service)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    if (json.data && json.data.token) {",
									"        pm.environment.set(\"auth_token\", json.data.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Content-Type", "value": "application/json", "type": "text"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"PT Samudera Pratama\",\n    \"email\": \"samudera@example.test\",\n    \"password\": \"password\",\n    \"password_confirmation\": \"password\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/register",
							"host": ["{{base_url}}"],
							"path": ["api", "register"]
						}
					}
				},
