		{
			"name": "03. Shipments",
			"description": "Endpoints for Shipment CRUD, Manifest Items, and Filtering.",
			"item": [
				{
					"name": "List Shipments (Paginated + Filtered)",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"url": {
							"raw": "{{base_url}}/api/shipments?page=1&per_page=10&status=CREATED",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments"],
							"query": [
								{"key": "page", "value": "1"},
								{"key": "per_page", "value": "10"},
								{"key": "status", "value": "CREATED"}
							]
						}
					}
				},
				{
					"name": "Create Shipment with Items (Operator/Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () { pm.response.to.have.status(201); });",
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    if (json.data && json.data.id) {",
									"        pm.environment.set(\"shipment_id\", json.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Content-Type", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"customer_id\": 3,\n    \"carrier_id\": 1,\n    \"origin_id\": 1,\n    \"destination_id\": 3,\n    \"cargo_type\": \"Medical Supplies & Diagnostics\",\n    \"expected_departure\": \"2026-12-01 10:00:00\",\n    \"expected_arrival\": \"2026-12-06 18:00:00\",\n    \"estimated_arrival\": \"2026-12-06 18:00:00\",\n    \"notes\": \"Urgent hospital diagnostic cargo\",\n    \"items\": [\n        {\n            \"item_name\": \"Immunoassay Analyzers\",\n            \"quantity\": 25,\n            \"weight_kg\": 1250.00,\n            \"volume_cbm\": 8.50,\n            \"package_type\": \"Crate\",\n            \"hs_code\": \"9027.80\"\n        },\n        {\n            \"item_name\": \"Reagent Kits Pack\",\n            \"quantity\": 100,\n            \"weight_kg\": 400.00,\n            \"volume_cbm\": 3.20,\n            \"package_type\": \"Carton\",\n            \"hs_code\": \"3822.00\"\n        }\n    ]\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/shipments",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments"]
						}
					}
				},
				{
					"name": "Get Shipment Details",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"url": {
							"raw": "{{base_url}}/api/shipments/{{shipment_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments", "{{shipment_id}}"]
						}
					}
				},
				{
					"name": "Update Shipment (Operator/Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Content-Type", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"cargo_type\": \"Medical Supplies & Diagnostics (High Priority)\",\n    \"notes\": \"Updated: priority customs clearance required upon arrival.\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/shipments/{{shipment_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments", "{{shipment_id}}"]
						}
					}
				},
				{
					"name": "Delete Shipment (Operator/Admin - CREATED or BOOKED only)",
					"request": {
						"method": "DELETE",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"url": {
							"raw": "{{base_url}}/api/shipments/{{shipment_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments", "{{shipment_id}}"]
						}
					}
				}
			]
		}
	]
