						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"exception_type\": \"WEATHER_DELAY\",\n    \"severity\": \"MEDIUM\",\n    \"impact_hours\": 14,\n    \"description\": \"Tropical storm near South China Sea corridor causing vessel slow steaming.\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/shipments/1/exceptions",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments", "1", "exceptions"]
						},
						"description": "Records a disruption exception and automatically adds impact_hours to shipment estimated arrival, recalculating delay severity."
					}
				},
				{
					"name": "3. Update Exception Status to RESOLVED (Operator)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () { pm.response.to.have.status(200); });",
									"pm.test(\"Exception status updated to RESOLVED\", function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.data.status).to.eql(\"RESOLVED\");",
									"    pm.expect(json.data.resolved_at).to.not.be.null;",
									"});"
								],
								"type": "text/javascript"
							}
