		{
			"name": "03. Shipments",
			"description": "Endpoints for Shipment CRUD, Manifest Items, and Filtering.",
			"item": [
				{
					"name": "List Shipments (Paginated + Filtered)",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"url": {
							"raw": "{{base_url}}/api/shipments?page=1&per_page=10&status=CREATED",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments"],
							"query": [
								{"key": "page", "value": "1"},
								{"key": "per_page", "value": "10"},
								{"key": "status", "value": "CREATED"}
							]
						}
					}
				},
				{
					"name": "Create Shipment with Items (Operator/Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () { pm.response.to.have.status(201); });",
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    if (json.data && json.data.id) {",
									"        pm.environment.set(\"shipment_id\", json.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Content-Type", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"customer_id\": 3,\n    \"carrier_id\": 1,\n    \"origin_id\": 1,\n    \"destination_id\": 3,\n    \"cargo_type\": \"Medical Supplies & Diagnostics\",\n    \"expected_departure\": \"2026-12-01 10:00:00\",\n    \"expected_arrival\": \"2026-12-06 18:00:00\",\n    \"estimated_arrival\": \"2026-12-06 18:00:00\",\n    \"notes\": \"Urgent hospital diagnostic cargo\",\n    \"items\": [\n        {\n            \"item_name\": \"Immunoassay Analyzers\",\n            \"quantity\": 25,\n            \"weight_kg\": 1250.00,\n            \"volume_cbm\": 8.50,\n            \"package_type\": \"Crate\",\n            \"hs_code\": \"9027.80\"\n        },\n        {\n            \"item_name\": \"Reagent Kits Pack\",\n            \"quantity\": 100,\n            \"weight_kg\": 400.00,\n            \"volume_cbm\": 3.20,\n            \"package_type\": \"Carton\",\n            \"hs_code\": \"3822.00\"\n        }\n    ]\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/shipments",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments"]
						}
					}
				},
				{
					"name": "Get Shipment Details",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"url": {
							"raw": "{{base_url}}/api/shipments/{{shipment_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments", "{{shipment_id}}"]
						}
					}
				},
				{
					"name": "Update Shipment (Operator/Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Content-Type", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"cargo_type\": \"Medical Supplies & Diagnostics (High Priority)\",\n    \"notes\": \"Updated: priority customs clearance required upon arrival.\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/shipments/{{shipment_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments", "{{shipment_id}}"]
						}
					}
				},
				{
					"name": "Delete Shipment (Operator/Admin - CREATED or BOOKED only)",
					"request": {
						"method": "DELETE",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"url": {
							"raw": "{{base_url}}/api/shipments/{{shipment_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments", "{{shipment_id}}"]
						}
					}
				}
			]
		},
		{
			"name": "04. Tracking & Lifecycle",
			"description": "Endpoints for Cargo Tracking Timeline and Checkpoint Lifecycle State Machine.",
			"item": [
				{
					"name": "Get Shipment Tracking Timeline",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"url": {
							"raw": "{{base_url}}/api/shipments/1/tracking",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments", "1", "tracking"]
						},
						"description": "Retrieves the full chronological milestone events history for a shipment."
					}
				},
				{
					"name": "1. Transition to BOOKED",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Shipment status updated to BOOKED\", function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.data.status).to.eql(\"BOOKED\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Content-Type", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"BOOKED\",\n    \"event_time\": \"2026-11-17 10:00:00\",\n    \"location_id\": 1,\n    \"location_name\": \"Tanjung Priok Container Terminal, Jakarta\",\n    \"latitude\": -6.1018800,\n    \"longitude\": 106.8833800,\n    \"description\": \"Carrier slot booking confirmed for voyage.\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/shipments/1/tracking",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments", "1", "tracking"]
						},
						"description": "Lifecycle Step 1: Transition shipment status from CREATED to BOOKED."
					}
				},
				{
					"name": "2. Transition to PICKED_UP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Shipment status updated to PICKED_UP\", function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.data.status).to.eql(\"PICKED_UP\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Content-Type", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"PICKED_UP\",\n    \"event_time\": \"2026-11-17 14:00:00\",\n    \"location_id\": 1,\n    \"location_name\": \"Cakung Container Depot, Jakarta\",\n    \"description\": \"Empty container picked up, stuffed, and sealed with cargo.\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/shipments/1/tracking",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments", "1", "tracking"]
						},
						"description": "Lifecycle Step 2: Transition shipment status from BOOKED to PICKED_UP."
					}
				},
				{
					"name": "3. Transition to IN_TRANSIT",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Shipment status updated to IN_TRANSIT\", function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.data.status).to.eql(\"IN_TRANSIT\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Content-Type", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"IN_TRANSIT\",\n    \"event_time\": \"2026-11-18 08:00:00\",\n    \"location_id\": 1,\n    \"location_name\": \"Port of Tanjung Priok Berth 102\",\n    \"latitude\": -6.1018800,\n    \"longitude\": 106.8833800,\n    \"description\": \"Vessel loaded and departed from origin port. Voyage underway.\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/shipments/1/tracking",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments", "1", "tracking"]
						},
						"description": "Lifecycle Step 3: Transition shipment status from PICKED_UP to IN_TRANSIT."
					}
				},
				{
					"name": "4. Transition to DELIVERED",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Shipment status updated to DELIVERED\", function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.data.status).to.eql(\"DELIVERED\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Content-Type", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"DELIVERED\",\n    \"event_time\": \"2026-11-20 16:00:00\",\n    \"location_id\": 3,\n    \"location_name\": \"Port of Singapore Tanjong Pagar Terminal\",\n    \"latitude\": 1.2644000,\n    \"longitude\": 103.8222000,\n    \"description\": \"Vessel safely berthed. Container discharged and delivered to consignee.\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{base_url}}/api/shipments/1/tracking",
							"host": ["{{base_url}}"],
							"path": ["api", "shipments", "1", "tracking"]
						},
						"description": "Lifecycle Step 4: Final transition from IN_TRANSIT to DELIVERED (Terminal Status)."
					}
				},
				{
					"name": "5. Reject Transition After DELIVERED (Negative Test)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 422 Unprocessable Content\", function () {",
									"    pm.response.to.have.status(422);",
									"});",
									"pm.test(\"Error indicates terminal status violation\", function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.success).to.be.false;",
									"    pm.expect(json.message).to.include(\"DELIVERED bersifat terminal\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"},
							{"key": "Content-Type", "value": "application/json", "type": "text"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text"}
						],
						"body": {
							"mode": "raw",
